# LLM API configuration (any LLM API in the OpenAI SDK format)
# Free / open routes:
#   OpenRouter : https://openrouter.ai/api/v1    openrouter/free
#                free key at https://openrouter.ai/keys, models ending in ":free" cost nothing
#   OmniRoute  : http://127.0.0.1:20128/v1       auto (npm i -g omniroute; key optional by default)
#   Ollama     : http://127.0.0.1:11434/v1       llama3.1   (local, no key needed - any placeholder works)
#   Groq       : https://api.groq.com/openai/v1  llama-3.3-70b-versatile
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.5-flash
# Paid routes: Alibaba Bailian (https://bailian.console.aliyun.com/), OpenAI, DeepSeek
# Note: this burns tokens quickly; start with simulations under 40 rounds
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=openrouter/free

# ===== Zep memory graph configuration =====
# The free monthly quota is enough for simple use: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Boost LLM configuration (optional) =====
# Note: when you do not use the boost configuration, leave these lines out of the env file
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
