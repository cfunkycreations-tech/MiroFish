# ===== MiroFish desktop configuration template =====
# On first launch, MiroFish copies this file to %APPDATA%\MiroFish\.env and generates SECRET_KEY for you.
# Restart the app after changing an API key.

# ---- LLM (any OpenAI-compatible endpoint) ----
# Free / open routes (pick one, then paste your key):
#   OpenRouter : https://openrouter.ai/api/v1    openrouter/free
#   OmniRoute  : http://127.0.0.1:20128/v1       auto (npm i -g omniroute; key optional by default)
#   Ollama     : http://127.0.0.1:11434/v1       llama3.1   (no key needed)
#   Groq       : https://api.groq.com/openai/v1  llama-3.3-70b-versatile
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.5-flash
# Paid routes: Alibaba Bailian (dashscope), OpenAI, DeepSeek
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=openrouter/free

# ---- Zep Cloud memory graph https://app.getzep.com/ ----
ZEP_API_KEY=

# ---- Optional: boost LLM ----
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=

# ---- Optional: number of simulation rounds ----
# OASIS_DEFAULT_MAX_ROUNDS=10
